layout {

    focus-ring {
        active-color   "#e2c373"
        inactive-color "#16130e"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#e2c373"
        inactive-color "#16130e"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#e2c373"
        inactive-color "#a98e43"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#e2c37380"
    }
}

recent-windows {
    highlight {
        active-color "#e2c373"
        urgent-color "#ffb4ab"
    }
}
