layout {

    focus-ring {
        active-color   "#abc7fb"
        inactive-color "#121316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#abc7fb"
        inactive-color "#121316"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#abc7fb"
        inactive-color "#5773a2"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#abc7fb80"
    }
}

recent-windows {
    highlight {
        active-color "#abc7fb"
        urgent-color "#ffb4ab"
    }
}
