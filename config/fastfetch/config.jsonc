{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/gentoo.png",
    "width": 24,
    "height": 12,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    },
    "color": {
      "1": "#63c7fb",
      "2": "#63c7dd"
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "#abc7fb",
      "title": "#bdc7dd"
    },
    "percent": {
      "type": 5,
      "color": {
        "green": "#eab6e9",
        "yellow": "#abc7fb",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "custom",
      "format": "─── Hardware ───"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU"
    },
    {
      "type": "memory",
      "key": "󰘚 RAM"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk"
    },
    "break",
    {
      "type": "custom",
      "format": "─── Software ───"
    },
    {
      "type": "os",
      "key": " OS"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel"
    },
    {
      "type": "shell",
      "key": "󰆍 Shell"
    },
    {
      "type": "de",
      "key": "󰖲 DE"
    },
    {
      "type": "wm",
      "key": "󰖳 WM"
    },
    "break",
    {
      "type": "packages",
      "key": "󰏖 Packages"
    },
    {
      "type": "uptime",
      "key": "󰔚 Uptime"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
