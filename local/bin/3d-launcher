#!/bin/sh
# Открывает окно настроек 3D-модели лаунчера; запускает лаунчер, если он не запущен.
if ! qs list -c serplauncher >/dev/null 2>&1; then
    setsid -f qs -c serplauncher >/dev/null 2>&1 </dev/null
    i=0; while [ $i -lt 50 ] && ! qs list -c serplauncher >/dev/null 2>&1; do sleep 0.1; i=$((i+1)); done
    sleep 0.5
fi
exec qs ipc -c serplauncher call modelsettings open
